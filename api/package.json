{
	"name": "duorou-api",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"start": "tsx src/server.ts",
		"build": "esbuild src/server.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/server.cjs --external:better-sqlite3 --external:sharp",
		"start:prod": "node dist/server.js"
	},
	"dependencies": {
		"@fastify/cors": "^10.0.1",
		"@fastify/multipart": "^9.0.1",
		"@fastify/static": "^8.0.3",
		"better-sqlite3": "^11.5.0",
		"fastify": "^5.1.0",
		"nanoid": "^5.0.9"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.12",
		"@types/node": "^22.10.1",
		"esbuild": "^0.24.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2"
	}
}